{
	"name": "toolbox-storage",
	"version": "1.0.0",
	"description": "Helpers for working with Toolbox's data storage formats.",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"files": [
		"dist/*"
	],
	"imports": {
		"#blobInternals": {
			"node": "./dist/usernotes/blobInternals.node.js",
			"default": "./dist/usernotes/blobInternals.default.js"
		}
	},
	"scripts": {
		"fmt": "dprint fmt",
		"fmt:check": "dprint check",
		"build": "tsc -b",
		"test": "ava",
		"coverage": "nyc ava",
		"prepublishOnly": "dprint check && tsc -b && ava"
	},
	"repository": {
		"url": "git+https://github.com/toolbox-team/storage.git"
	},
	"author": "eritbh <github@eritbh.me>",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/toolbox-team/storage/issues"
	},
	"homepage": "https://github.com/toolbox-team/storage/tree/main/packages/toolbox-storage#readme",
	"optionalDependencies": {
		"core-js": "^3.40.0",
		"pako": "^1.0.11"
	},
	"devDependencies": {
		"@ava/typescript": "^5.0.0",
		"@tsconfig/node-lts": "^22.0.1",
		"@types/node": "^22.13.5",
		"@types/pako": "^2.0.3",
		"ava": "^6.2.0",
		"dprint": "^0.40.2",
		"nyc": "^15.0.0"
	},
	"ava": {
		"typescript": {
			"compile": false,
			"rewritePaths": {
				"src/": "dist/"
			}
		}
	},
	"typedocOptions": {
		"entryPoints": [
			"src/index.ts"
		]
	}
}
